#inlcude <stdio.h>

#define MAX 6
int box[MAX];
int top = -1;

void push(int x){
  if(top == MAX -1){
    printf(" Stack is full !! Cannot push %d\n" ,x);
  }else{
   top++;
   box[top]=x;
   printf("Value %d has been added \n", x);
   }
}

void display() {
  if (top == -1) {
    printf("Stack is empty. \n");
  return;
}
printf("Current stack: ");
  for( int i=top; i>=0; i--){
     printf("%d ", box[i]);
}
printf("\n");
}

int main() {
printf("pushing elements \n");
  push(1);
    push(2);
    push(3);
    
    
    display();

    push(4);
    push(5);
    push(6);
    push(7); // This will show the stack is full

   display();

   printf("\n Popping Elements \n");
   pop();
   pop();

   display();

   return 0;
}
